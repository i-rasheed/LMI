{
  "expo": {
    "name": "LMI",
    "slug": "lmi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lmi",
    "userInterfaceStyle": "light",
    "icon": "./assets/lmi-logo.png",
    "splash": {
      "image": "./assets/lmi-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8F52"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.lmi.app",
      "icon": "./assets/lmi-logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/lmi-logo.png",
        "backgroundColor": "#0A8F52"
      },
      "package": "ng.lmi.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@sentry/react-native/expo",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LMI uses your location to show nearby Lagos markets."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/lmi-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A8F52"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65c09038-8ad6-4c63-850c-a3c2135dace0"
      }
    }
  }
}
